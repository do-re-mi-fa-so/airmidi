{
  "name": "airmidi",
  "version": "0.1.0",
  "description": "BLE-MIDI over Web Bluetooth — connect to BLE MIDI devices directly from the browser.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "midi",
    "ble-midi",
    "bluetooth",
    "web-bluetooth",
    "web-midi"
  ],
  "author": "c3v6a2vy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/do-re-mi-fa-so/airmidi.git"
  },
  "homepage": "https://github.com/do-re-mi-fa-so/airmidi#readme",
  "bugs": {
    "url": "https://github.com/do-re-mi-fa-so/airmidi/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/web-bluetooth": "^0.0.20",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
